<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Wyspa.App">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Geometry x:Key="GitHubMark">M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656</Geometry>
    <!-- Semantic surface tokens. ThemeService supplies dark and high contrast values. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#171717" />
    <SolidColorBrush x:Key="MutedBrush" Color="#505050" />
    <SolidColorBrush x:Key="LineBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{x:Static SystemColors.AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#9D4C20" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LogoGradientBrush" Color="{x:Static SystemColors.AccentColor}" />
    <sys:Double x:Key="PageTitleSize">28</sys:Double>
    <sys:Double x:Key="BodySize">14</sys:Double>
    <sys:Double x:Key="CaptionSize">12</sys:Double>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <CornerRadius x:Key="SurfaceRadius">4</CornerRadius>
    <Thickness x:Key="PagePadding">24,20,24,24</Thickness>
    <Thickness x:Key="RowPadding">16,12</Thickness>

    <!-- Keep Microsoft's Fluent templates, including interaction and focus states. -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Margin" Value="0,6,0,6" />
    </Style>

    <Style TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="CanContentScroll" Value="False" />
    </Style>
    <Style TargetType="Hyperlink" BasedOn="{StaticResource DefaultHyperlinkStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="FontSize" Value="{StaticResource PageTitleSize}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="Margin" Value="0,12,0,2" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SettingsSubsection" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeaderHelpIcon" TargetType="local:HelpButton">
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HelpButton">
                    <Border x:Name="HitArea" Background="{TemplateBinding Background}" CornerRadius="4">
                        <Border Width="16" Height="16" CornerRadius="8" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                            <TextBlock Text="?" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitArea" Property="Background" Value="{DynamicResource PanelAltBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HitArea" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation keeps TabControl selection and keyboard behavior. -->
    <Style x:Key="NavigationItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="12,10">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="Selection" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelAltBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter TargetName="Selection" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationFooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4,8,4,12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="NavigationShell" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Rail" Width="232" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Bottom" Command="{x:Static local:AppNavigationCommands.OpenRepository}" Style="{StaticResource NavigationFooterButton}" AutomationProperties.Name="About Wyspa on GitHub" ToolTip="About Wyspa — open the repository on GitHub">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GitHubMark}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource InkBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="About" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,8,0,0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="Rail" Property="Width" Value="160" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width disclosure row: real Expander semantics, no decorative controls. -->
    <Style x:Key="SettingsGroup" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{TemplateBinding Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="4" Padding="16,14" MinHeight="72">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Uid, RelativeSource={RelativeSource AncestorType=Expander}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextWrapping="Wrap" FontSize="14" />
                                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Style="{StaticResource BodyText}" Margin="0,3,8,0" />
                                                </StackPanel>
                                                <Path x:Name="Chevron" Grid.Column="2" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource PanelAltBrush}" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ExpandedSite" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
                                <ContentPresenter Margin="16,0,16,16" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedSite" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsField" TargetType="HeaderedContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ControlColumn" Width="300" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ContentPresenter x:Name="Field" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="ControlColumn" Property="Width" Value="0" />
                            <Setter TargetName="Field" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Field" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Field" Property="Margin" Value="0,8,0,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF has no built-in ToggleSwitch. Retain CheckBox automation/toggle semantics. -->
    <Style x:Key="SettingsToggle" TargetType="CheckBox">
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Padding="{StaticResource RowPadding}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" Text="Off" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" />
                                <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="StateText" Property="Text" Value="On" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelAltBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
