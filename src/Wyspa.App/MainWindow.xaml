<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Wyspa.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wyspa.App.MainWindow" Title="WyspaFluent" Style="{StaticResource {x:Type Window}}" Icon="Assets/AppIcon.ico" Width="1180" Height="860" MinWidth="560" MinHeight="480" PreviewKeyDown="Window_OnPreviewKeyDown" Background="{DynamicResource AppBackgroundBrush}" xmlns:models="clr-namespace:Wyspa.Core.Models;assembly=Wyspa.Core">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenLocalSettings}" Executed="OpenLocalSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenGroqSettings}" Executed="OpenGroqSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" Executed="OpenAudioSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenConversationSettings}" Executed="OpenConversationSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenRepository}" Executed="OpenRepository_OnExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <local:LocalTableHeightConverter x:Key="TableHeight" />
        <Style x:Key="LocalTableCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="6,2"><ContentPresenter VerticalAlignment="Center" /></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LocalTableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><DataGridCellsPresenter x:Name="PART_CellsPresenter" /></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModelManagerRow" TargetType="DataGridRow" BasedOn="{StaticResource LocalTableRow}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LocalTableText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LocalHeaderGrip" TargetType="Thumb"><Setter Property="Width" Value="6" /><Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="SizeWE" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="LocalTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
                <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1">
                    <Grid MinHeight="32">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource LocalHeaderGrip}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource LocalHeaderGrip}" />
                    </Grid>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PerformanceRow" TargetType="DataGridRow" BasedOn="{StaticResource LocalTableRow}">
            <Style.Triggers><DataTrigger Binding="{Binding IsWinner}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LocalTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource LocalTableHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource LocalTableCell}" />
            <Setter Property="RowStyle" Value="{StaticResource LocalTableRow}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserSortColumns" Value="False" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="TestingSpinner" TargetType="Grid">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform /></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Name="SpinnerRotation"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" /></Storyboard></BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="SpinnerRotation" /></Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppLogo.png" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="WyspaFluent" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionMessage}" Style="{StaticResource BodyText}" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="340" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="24,0,0,0" />
            </Grid>
        </Border>
        <TabControl x:Name="MainNavigation" Grid.Row="1" TabStripPlacement="Left" Style="{StaticResource NavigationShell}" AutomationProperties.Name="Main navigation">
                    <TabItem AutomationProperties.Name="Home">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" Width="24" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Padding="{StaticResource PagePadding}">
                            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                                <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Start dictation or get your connection ready." Style="{StaticResource BodyText}" Margin="0,0,0,24" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="Dictation" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleListeningCommand}" IsEnabled="{Binding CanListen}" Content="{Binding ToggleText}" ToolTip="Start or stop dictation using the current listening mode. The global shortcut also works while Wyspa is in the tray." />
                                            <Button Content="Dictation settings" Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" ToolTip="Open Audio &amp; Capture to choose the microphone, listening mode and shortcuts." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Getting Started" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="New installations include lightweight English dictation. Local processing starts without an account or voice training; the engine prepares in the background." Style="{StaticResource BodyText}" Margin="0,0,0,12" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <StackPanel Margin="16">
                                            <TextBlock Text="1. Check your microphone" FontWeight="SemiBold" />
                                            <TextBlock Text="Use the Windows default input, or choose your microphone in Audio &amp; Capture and check the level meter." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                            <Button Content="Open Audio &amp; Capture" Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" HorizontalAlignment="Left" ToolTip="Choose and check your microphone, listening mode and shortcut." />
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="2. Start dictating" FontWeight="SemiBold" />
                                                <TextBlock Text="Focus a text field and use the shortcut shown above. Press it again to stop. Stream Mode can insert words while you speak; your complete dictation is also kept on the clipboard." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="Optional: choose a different model" FontWeight="SemiBold" />
                                                <TextBlock Text="Try Whisper for punctuation, other languages or GPU acceleration. Voice setup can test accuracy and tune pause timing, but is optional." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                                <Button Content="Local model settings" Command="{x:Static local:AppNavigationCommands.OpenLocalSettings}" HorizontalAlignment="Left" ToolTip="Choose models, GPU acceleration and optional voice setup." />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="Optional: use Groq cloud processing" FontWeight="SemiBold" />
                                                <TextBlock Text="If local recognition is too slow or you want cloud features, create a Groq account and API key, then save and test the key in Groq settings. Turn local transcription off to use Groq." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                                <TextBlock Style="{StaticResource BodyText}"><Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_OnRequestNavigate" ToolTip="Open the official Groq website to create an optional cloud API key.">Open Groq Console</Hyperlink></TextBlock>
                                                <Button Content="Open Groq settings" Command="{x:Static local:AppNavigationCommands.OpenGroqSettings}" HorizontalAlignment="Left" ToolTip="Set up optional cloud processing." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem AutomationProperties.Name="Audio Files">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M12,16 V3 M7,8 L12,3 L17,8 M3,15 V19 Q3,21 5,21 H19 Q21,21 21,19 V15" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Audio Files" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:FileTranscriptionView DataContext="{Binding FileTranscription}" />
                    </TabItem>
                    <TabItem AutomationProperties.Name="Conversation">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M6.5,21 V17.5 C3.7,15.7 2,13.2 2,9.5 C2,5.4 4.9,2.5 8.7,2.5 C12.6,2.5 14.8,5.1 14.8,8 L16.4,10.4 L14.8,11.3 V14 Q14.8,16 12.7,16 H10.5 V21 Z M12.5,12.7 H14.8" />
                                            <Path Style="{StaticResource NavigationIcon}" Data="M18.7,10.1 C20,11.5 20,13.9 18.7,15.3 M21.4,7.8 C23.9,10 23.9,15.4 21.4,17.6" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Conversation" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:NotesView DataContext="{Binding Notes}" />
                    </TabItem>
                    <TabItem AutomationProperties.Name="YouTube">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M6,5 H18 Q22,5 22,9 V15 Q22,19 18,19 H6 Q2,19 2,15 V9 Q2,5 6,5 Z" />
                                            <Path Style="{StaticResource NavigationIcon}" Data="M10,8.5 L16,12 L10,15.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="0" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="YouTube" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:VideoView DataContext="{Binding Videos}" />
                    </TabItem>
                    <TabItem x:Name="SettingsTab" AutomationProperties.Name="Settings">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" Width="24" FontSize="16" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer x:Name="SettingsScroll" Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SettingsContent" Loaded="SettingsContent_OnLoaded" MaxWidth="1040" HorizontalAlignment="Stretch">
                                <StackPanel.Resources>
                                    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSubsection}">
                                    </Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}" />
                                </StackPanel.Resources>
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Make Wyspa work your way. Preferences save automatically; keys and shortcuts have a Save button." Style="{StaticResource BodyText}" Margin="0,0,0,24" />
                                <Expander x:Name="LocalSettingsGroup" Header="Local models" Tag="Private transcription on this computer · no API key required" Uid="&#xE770;" Style="{StaticResource SettingsGroup}" AutomationProperties.Name="Local models settings">
                                    <StackPanel DataContext="{Binding LocalModels}">
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Use local transcription" Tag="On keeps speech recognition on this PC. Off uses Groq. Voice setup is optional; install a model below if needed.">
                                            <CheckBox Style="{StaticResource SettingsToggle}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEnable}" AutomationProperties.Name="Use local transcription" ToolTip="Enable local mode to manage models and transcribe without a Groq key." />
                                        </HeaderedContentControl>
                                        <StackPanel IsEnabled="{Binding Enabled}">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers></Style></StackPanel.Style>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="GPU acceleration" Tag="Allow compatible models to use the GPU. This option is unavailable if no compatible GPU is detected.">
                                            <StackPanel>
                                                <CheckBox Content="Use GPU acceleration when available" IsChecked="{Binding GpuEnabled}" IsEnabled="{Binding CanUseGpu}" AutomationProperties.Name="Use GPU acceleration when available" ToolTip="Use a detected compatible Vulkan GPU for Whisper. Applies when the next model context loads." />
                                                <TextBlock Text="GPU permission lets Wyspa choose a supported GPU. Compare Models measures CPU and GPU separately where supported, and Wyspa uses the faster comparable result for each model. CPU-only engines stay on CPU." Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource BodyText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="Model Manager" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="All available local models. Select checkboxes to install or remove a batch; choose Use to make an installed model active. Hover over a model for languages, engine and other details. Downloads are verified before installation." Style="{StaticResource BodyText}" Margin="0,4,0,12" />
                                                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="62" MaxHeight="{Binding ActualHeight, ElementName=SettingsScroll, Converter={StaticResource TableHeight}, ConverterParameter=410}" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Local model manager" Style="{StaticResource LocalTable}" RowStyle="{StaticResource ModelManagerRow}" SelectionChanged="LocalTable_OnSelectionChanged">
                                                    <DataGrid.Resources><Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}"><Setter Property="HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" /></Style></DataGrid.Resources>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Select" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" ToolTip="Select this model for a batch install or removal." Style="{x:Null}" />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Model" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding Details}">
                                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                        <DataGridTextColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Size" Binding="{Binding Size}" Width="80" ElementStyle="{StaticResource LocalTableText}" />
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Status" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="6,0">
                                                                <TextBlock Text="{Binding State}" TextWrapping="Wrap" MaxHeight="36" ToolTip="{Binding State}" AutomationProperties.LiveSetting="Polite" />
                                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="{Binding Name, StringFormat=Download progress for {0}}" />
                                                            </StackPanel>
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Action" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Content="{Binding ActionLabel}" Command="{Binding ManageCommand}" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Install or remove {0}}" ToolTip="Install a missing model, or remove its downloaded files." />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="About" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Tag="{Binding InfoUrl}" Click="ModelInfo_OnClick" Width="32" Height="32" Padding="4" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Information about {0}}" ToolTip="Open the publisher's model card or project page in your browser.">
                                                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M14,4 H20 V10 M20,4 L11,13 M10,5 H6 Q4,5 4,7 V18 Q4,20 6,20 H17 Q19,20 19,18 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                                                            </Button>
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                        <DataGridTemplateColumn HeaderStyle="{StaticResource LocalTableHeader}" Header="Dictation" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                            <Button Content="{Binding UseLabel}" Command="{Binding UseCommand}" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}" ToolTip="Use this installed model for local transcription." />
                                                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <WrapPanel Margin="0,12,0,4">
                                                    <Button Content="Install selected" Command="{Binding InstallSelectedCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Download selected missing models, up to two together. Installed selections are kept." />
                                                    <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" ToolTip="Remove selected installed models. If the active model is removed, another installed model is used when available." />
                                                    <Button Content="Cancel batch" Command="{Binding CancelCommand}" ToolTip="Cancel outstanding downloads or removals. Completed changes are kept." />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="{Binding Availability}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding StoragePath}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Expander Header="Model advice and local / Groq comparison" IsExpanded="{Binding Recommendations.IsExpanded}" Margin="16,4,16,16" AutomationProperties.Name="Model recommendations and speed comparison">
                                            <StackPanel DataContext="{Binding Recommendations}" Margin="0,12,0,0">
                                                <TextBlock Text="{Binding HardwareSuggestion}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="Test every installed local model, including Whisper, Zipformer, Parakeet and Moonshine. The same 11-second English public speech sample is used for all providers. No microphone recording is made. No model weights are downloaded by the test. Faster-Whisper GPU testing may prepare its optional CUDA runtime once; its download size is shown in the model details." Style="{StaticResource BodyText}" Margin="0,8,0,8" />
                                                <WrapPanel>
                                                    <Button Content="Compare Models" Command="{Binding TestLocalCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Measure installed models on this PC using the included sample. No upload or microphone capture." />
                                                    <Button Content="Compare with Groq" Command="{Binding CompareGroqCommand}" ToolTip="Send the included public sample to your selected Groq speech model using your saved key. Four test requests; API quota may apply. No user recordings are sent." />
                                                    <Button Content="Cancel test" Command="{Binding CancelCommand}" ToolTip="Cancel testing and resume dictation. Completed timings are retained." />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding ComparisonAvailability}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                                <DockPanel Margin="0,8,0,8">
                                                    <Grid Style="{StaticResource TestingSpinner}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="Model testing in progress">
                                                        <Canvas Width="24" Height="24">
                                                        <Line X1="12.00" Y1="6.00" X2="12.00" Y2="2.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.08" />
                                                        <Line X1="15.00" Y1="6.80" X2="17.00" Y2="3.34" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.17" />
                                                        <Line X1="17.20" Y1="9.00" X2="20.66" Y2="7.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.25" />
                                                        <Line X1="18.00" Y1="12.00" X2="22.00" Y2="12.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.33" />
                                                        <Line X1="17.20" Y1="15.00" X2="20.66" Y2="17.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.42" />
                                                        <Line X1="15.00" Y1="17.20" X2="17.00" Y2="20.66" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.50" />
                                                        <Line X1="12.00" Y1="18.00" X2="12.00" Y2="22.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.58" />
                                                        <Line X1="9.00" Y1="17.20" X2="7.00" Y2="20.66" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.67" />
                                                        <Line X1="6.80" Y1="15.00" X2="3.34" Y2="17.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.75" />
                                                        <Line X1="6.00" Y1="12.00" X2="2.00" Y2="12.00" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.83" />
