<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Wyspa.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wyspa.App.MainWindow" Title="WyspaFluent" Style="{StaticResource {x:Type Window}}" Icon="Assets/AppIcon.ico" Width="1180" Height="860" MinWidth="560" MinHeight="480" PreviewKeyDown="Window_OnPreviewKeyDown" Background="{DynamicResource AppBackgroundBrush}" xmlns:models="clr-namespace:Wyspa.Core.Models;assembly=Wyspa.Core">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenGroqSettings}" Executed="OpenGroqSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" Executed="OpenAudioSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenConversationSettings}" Executed="OpenConversationSettings_OnExecuted" />
        <CommandBinding Command="{x:Static local:AppNavigationCommands.OpenRepository}" Executed="OpenRepository_OnExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource ChromeBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppLogo.png" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="WyspaFluent" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionMessage}" Style="{StaticResource BodyText}" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="340" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="24,0,0,0" />
            </Grid>
        </Border>
        <TabControl x:Name="MainNavigation" Grid.Row="1" TabStripPlacement="Left" Style="{StaticResource NavigationShell}" AutomationProperties.Name="Main navigation">
                    <TabItem AutomationProperties.Name="Home">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" Width="24" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Padding="{StaticResource PagePadding}">
                            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                                <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Start dictation or get your connection ready." Style="{StaticResource BodyText}" Margin="0,0,0,24" />
                                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="Dictation" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleListeningCommand}" IsEnabled="{Binding CanListen}" Content="{Binding ToggleText}" />
                                            <Button Content="Dictation settings" Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Getting Started" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Connect Wyspa to Groq, then check your input before your first dictation." Style="{StaticResource BodyText}" Margin="0,0,0,12" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <StackPanel Margin="16">
                                            <TextBlock Text="1. Create a Groq account" FontWeight="SemiBold" />
                                            <TextBlock Text="Open Groq Console, sign up or sign in, and complete the account setup." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                            <TextBlock Style="{StaticResource BodyText}"><Hyperlink NavigateUri="https://console.groq.com/" RequestNavigate="Hyperlink_OnRequestNavigate">Open Groq Console</Hyperlink></TextBlock>
                                        </StackPanel>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="2. Create an API key" FontWeight="SemiBold" />
                                                <TextBlock Text="In Groq Console, open API Keys and create a new key for Wyspa. Copy the key and keep it private." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                                <TextBlock Style="{StaticResource BodyText}"><Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_OnRequestNavigate">Open API Keys</Hyperlink></TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="3. Connect Wyspa" FontWeight="SemiBold" />
                                                <TextBlock Text="Go to Settings → Groq, paste your key, then select Save and test key. Wyspa stores it encrypted for your Windows user. Choose your transcription and summary models in the same section." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                                <Button Content="Open Groq settings" Command="{x:Static local:AppNavigationCommands.OpenGroqSettings}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsRow}">
                                            <StackPanel>
                                                <TextBlock Text="4. Check your input and start dictating" FontWeight="SemiBold" />
                                                <TextBlock Text="In Audio &amp; Capture, choose your Input Device and check your speaking level under SmartListen Threshold. Choose a trigger mode and shortcut, then start dictation. Audio is sent to Groq when you transcribe." Style="{StaticResource BodyText}" Margin="0,4,0,8" />
                                                <Button Content="Open Audio &amp; Capture" Command="{x:Static local:AppNavigationCommands.OpenAudioSettings}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem AutomationProperties.Name="Audio Files">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M12,16 V3 M7,8 L12,3 L17,8 M3,15 V19 Q3,21 5,21 H19 Q21,21 21,19 V15" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Audio Files" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:FileTranscriptionView DataContext="{Binding FileTranscription}" />
                    </TabItem>
                    <TabItem AutomationProperties.Name="Conversation">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M6.5,21 V17.5 C3.7,15.7 2,13.2 2,9.5 C2,5.4 4.9,2.5 8.7,2.5 C12.6,2.5 14.8,5.1 14.8,8 L16.4,10.4 L14.8,11.3 V14 Q14.8,16 12.7,16 H10.5 V21 Z M12.5,12.7 H14.8" />
                                            <Path Style="{StaticResource NavigationIcon}" Data="M18.7,10.1 C20,11.5 20,13.9 18.7,15.3 M21.4,7.8 C23.9,10 23.9,15.4 21.4,17.6" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="Conversation" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:NotesView DataContext="{Binding Notes}" />
                    </TabItem>
                    <TabItem AutomationProperties.Name="YouTube">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource NavigationIcon}" Data="M6,5 H18 Q22,5 22,9 V15 Q22,19 18,19 H6 Q2,19 2,15 V9 Q2,5 6,5 Z" />
                                            <Path Style="{StaticResource NavigationIcon}" Data="M10,8.5 L16,12 L10,15.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="0" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="YouTube" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <local:VideoView DataContext="{Binding Videos}" />
                    </TabItem>
                    <TabItem x:Name="SettingsTab" AutomationProperties.Name="Settings">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" Width="24" FontSize="16" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer x:Name="SettingsScroll" Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SettingsContent" Loaded="SettingsContent_OnLoaded" MaxWidth="1040" HorizontalAlignment="Stretch">
                                <StackPanel.Resources>
                                    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSubsection}">
                                    </Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}" />
                                </StackPanel.Resources>
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Make Wyspa work your way. Preferences save automatically; keys and shortcuts have a Save button." Style="{StaticResource BodyText}" Margin="0,0,0,24" />
                                <Expander x:Name="GroqSettingsGroup" Header="Groq" Tag="Connection, transcription, and summary models" Uid="&#xE753;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Groq settings">
                                    <StackPanel>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="API key" Tag="Encrypted for this Windows user. Save and test a key to connect to Groq.">
                                            <StackPanel>
                                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged" GotKeyboardFocus="ApiKeyBox_OnGotKeyboardFocus" LostKeyboardFocus="ApiKeyBox_OnLostKeyboardFocus" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Groq API key" />
                                                <WrapPanel IsEnabled="{Binding Models.CanRefresh}">
                                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding TestConnectionCommand}" Content="Save and test key" />
                                                    <Button Command="{Binding RemoveKeyCommand}" Content="Remove key" />
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"><Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_OnRequestNavigate">Create a key in Groq Console</Hyperlink></TextBlock>
                                                <TextBlock Text="{Binding ConnectionMessage}" Style="{StaticResource BodyText}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Available models" Tag="Refresh the task-specific model lists from Groq.">
                                            <StackPanel>
                                                <Button Command="{Binding RefreshModelsCommand}" Content="Refresh models" IsEnabled="{Binding Models.CanRefresh}" HorizontalAlignment="Right" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Models.Status}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Transcription model" Tag="Speech to text for dictation, audio files, conversations, and YouTube.">
                                            <StackPanel>
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TranscriptionModels}" SelectedItem="{Binding Models.TranscriptionModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Transcription model" />
                                                <TextBlock Text="{Binding Models.TranscriptionSelection}" Style="{StaticResource BodyText}" Foreground="{DynamicResource WarnBrush}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Summary model" Tag="Summaries for conversations and YouTube videos.">
                                            <StackPanel>
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TextModels}" SelectedItem="{Binding Models.SummaryModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Summary model" />
                                                <TextBlock Text="{Binding Models.SummarySelection}" Style="{StaticResource BodyText}" Foreground="{DynamicResource WarnBrush}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Language" Tag="Optional language code, such as en. Leave blank for automatic detection.">
                                            <TextBox Text="{Binding Settings.Language, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Transcription language" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource SettingsField}" Header="Vocabulary prompt" Tag="Optional names, terms, or spellings to guide transcription.">
                                            <TextBox Text="{Binding Settings.CustomPrompt, UpdateSourceTrigger=LostFocus}" MaxLength="500" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" AutomationProperties.Name="Vocabulary prompt" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="ConversationSettingsGroup" Header="Conversation" Tag="Conversation type, call audio, and speaker detection" Uid="&#xE8F2;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Conversation settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel DataContext="{Binding Notes}">
                                            <Grid IsEnabled="{Binding CanConfigure}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Conversation mode" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="Conversation mode" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" IsEnabled="{Binding IsCallMode}">
                                                    <TextBlock Text="Call audio from" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding AudioModes}" SelectedIndex="{Binding AudioModeIndex}" AutomationProperties.Name="Call audio source" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid IsEnabled="{Binding CanConfigure}">
                                                <StackPanel IsEnabled="{Binding IsCallMode}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeviceMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Output device" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" AutomationProperties.Name="Output device" />
                                                </StackPanel>
                                                <StackPanel IsEnabled="{Binding IsCallMode}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeviceMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Calling app (includes its child processes)" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" DisplayMemberPath="Name" IsEnabled="{Binding SupportsApplicationCapture}" AutomationProperties.Name="Calling app" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Uses the microphone selected in Audio &amp; Capture below. Room speaker detection is experimental: choose your detected speaker below. Headphones help keep call audio out of your microphone." Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0" />
                                            <TextBlock Text="This Windows build supports output-device capture. App capture requires build 20348 or newer (Windows 11 recommended)." FontSize="11" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SupportsApplicationCapture}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Expander Header="Timing and speaker sensitivity" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" IsEnabled="{Binding CanConfigure}">
                                                <StackPanel Margin="0,5">
                                                    <TextBlock Text="{Binding Options.NoteChunkSeconds, StringFormat='Maximum live passage: {0:0.0} seconds'}" Style="{StaticResource BodyText}" />
                                                    <Slider AutomationProperties.Name="Maximum live passage in seconds" Minimum="1.5" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Options.NoteChunkSeconds}" ToolTip="Shorter passages appear sooner but create more Groq requests. Speech pauses send a passage early." />
                                                    <TextBlock Text="Speech threshold · lower for quiet voices, higher for background noise" Style="{StaticResource BodyText}" />
                                                    <Slider AutomationProperties.Name="Conversation speech threshold" Minimum="0.002" Maximum="0.05" Value="{Binding Options.NoteSpeechThreshold}" />
                                                    <TextBlock Text="Room speaker matching · lower if one voice gets several labels, higher if different voices merge" Style="{StaticResource BodyText}" />
                                                    <Slider AutomationProperties.Name="Room speaker matching" Minimum="0.3" Maximum="0.8" Value="{Binding Options.SpeakerMatchThreshold}" />
                                                </StackPanel>
                                            </Expander>
                                            <Button Content="Refresh capture sources" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="AudioSettingsGroup" Header="Audio &amp; Capture" Tag="Microphone, dictation shortcuts, and SmartListen" Uid="&#xE720;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Audio &amp; Capture settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Input Device" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Input Device&#10;- Select the Windows input device Wyspa records from.&#10;- Refresh after plugging in or changing devices.&#10;- The threshold meter previews levels locally while visible; preview audio is not saved or sent.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Input Device" ItemsSource="{Binding Devices}" SelectedValue="{Binding Settings.MicrophoneDeviceId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Name" />
                                                    <WrapPanel Margin="0,0,0,0">
                                                        <Button Command="{Binding RefreshDevicesCommand}" Content="Refresh" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Capture &amp; Shortcuts" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Capture &amp; Shortcuts&#10;- Choose how recording starts.&#10;- Calibrate SmartListen against your room noise.&#10;- Record global shortcuts by clicking the field, pressing keys, then saving.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Mode&#10;- Toggle: press once to start, press again to stop.&#10;- Hold to Talk: record only while the shortcut is held.&#10;- SmartListen: listens for speech above the threshold.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Dictation activation mode" SelectedValue="{Binding Settings.ActivationMode}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Toggle" Tag="{x:Static models:ActivationMode.Toggle}" />
                                                        <ComboBoxItem Content="Hold to Talk" Tag="{x:Static models:ActivationMode.HoldToTalk}" />
                                                        <ComboBoxItem Content="SmartListen" Tag="{x:Static models:ActivationMode.AutoCapture}" />
                                                    </ComboBox>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="SmartListen Threshold" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="SmartListen Threshold&#10;- Meter shows current microphone level.&#10;- Slider sets the trigger threshold from 0% to 100%.&#10;- Raise it if small noises start recording; lower it if speech is missed.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding MicrophoneLevelText}" Style="{StaticResource BodyText}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Value, ElementName=AutoCaptureThresholdSlider, StringFormat=Trigger {0:P0}}" />
                                                    </Grid>
                                                    <ProgressBar x:Name="InputLevelMeter" AutomationProperties.Name="Live microphone level" Minimum="0" Maximum="1" Value="{Binding MicrophoneLevel, Mode=OneWay}" Height="8" Margin="0,2,0,4" />
                                                    <TextBlock Text="Live input levels are shown while this meter is visible, even with SmartListen off. Preview audio stays on this PC and is not saved." Style="{StaticResource BodyText}" Margin="0,4,0,4" />
                                                    <TextBlock Text="{Binding InputLevelPreviewError}" Style="{StaticResource BodyText}" Foreground="{DynamicResource WarnBrush}" AutomationProperties.LiveSetting="Polite" />
                                                    <Slider AutomationProperties.Name="SmartListen trigger threshold" x:Name="AutoCaptureThresholdSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Value="{Binding Settings.AutoCaptureThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Silence Before Stop (ms)" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Silence Before Stop&#10;- How long SmartListen waits after you stop speaking.&#10;- Lower values finish faster.&#10;- Higher values allow longer pauses mid-sentence.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox AutomationProperties.Name="Silence before stop in milliseconds" Text="{Binding Settings.AutoCaptureSilenceMs, UpdateSourceTrigger=PropertyChanged}" />
                                                    <CheckBox Content="SmartListen Listening Enabled" IsChecked="{Binding Settings.AutoCaptureListeningEnabled}" ToolTip="Turns SmartListen's always-listening state on or off. This can also be toggled from the tray menu or the SmartListen listening shortcut." />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="SmartListen Media Handling" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="SmartListen Media Handling&#10;- Do Nothing: leave system audio alone.&#10;- Mute System Output: mute while listening, then restore the previous mute state.&#10;- Pause or Resume Media: sends the Windows play/pause key when listening turns on and again when it turns off.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="SmartListen media handling" SelectedValue="{Binding Settings.AutoCaptureMediaBehavior}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Do Nothing" Tag="{x:Static models:AutoCaptureMediaBehavior.None}" />
                                                        <ComboBoxItem Content="Mute System Output" Tag="{x:Static models:AutoCaptureMediaBehavior.MuteSystemOutput}" />
                                                        <ComboBoxItem Content="Pause or Resume Media" Tag="{x:Static models:AutoCaptureMediaBehavior.TogglePlayPause}" />
                                                    </ComboBox>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Current Shortcut" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Current Shortcut&#10;- Click the box and press the shortcut.&#10;- Save Hotkey finishes recording it.&#10;- F13-F24 macro keys can be used without modifiers.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox AutomationProperties.Name="Dictation shortcut" x:Name="HotkeyRecorderBox" Text="{Binding HotkeyText, Mode=OneWay}" IsReadOnly="True" GotKeyboardFocus="HotkeyRecorderBox_OnGotKeyboardFocus" />
                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="SaveHotkeyButton_OnClick" Margin="7,2,0,5" Content="Save Hotkey" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="SmartListen Listening Shortcut" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="SmartListen Listening Shortcut&#10;- Toggles SmartListen listening on or off.&#10;- Gives tone and overlay feedback when changed.&#10;- Only applies to SmartListen mode.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox AutomationProperties.Name="SmartListen listening shortcut" x:Name="AutoCaptureHotkeyRecorderBox" Text="{Binding AutoCaptureHotkeyText, Mode=OneWay}" IsReadOnly="True" GotKeyboardFocus="AutoCaptureHotkeyRecorderBox_OnGotKeyboardFocus" />
                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="SaveAutoCaptureHotkeyButton_OnClick" Margin="7,2,0,5" Content="Save Hotkey" />
                                                    </Grid>
                                                    <TextBlock Text="Click a shortcut field, press your shortcut, then save it. F13-F24 macro keys can be used without modifiers." Style="{StaticResource BodyText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="LookAndFeelSettingsGroup" Header="Look &amp; Feel" Tag="Theme, overlay, text cleanup, and insertion" Uid="&#xE790;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Look &amp; Feel settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                                                    <TextBlock Text="Choose an appearance. System follows your Windows theme." Style="{StaticResource BodyText}" Margin="0,4,0,4" />
                                                    <ComboBox x:Name="ThemeSelector" AutomationProperties.Name="Theme" SelectedValue="{Binding Settings.Theme, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Dark" Tag="{x:Static models:AppTheme.Dark}" />
                                                        <ComboBoxItem Content="Light" Tag="{x:Static models:AppTheme.Light}" />
                                                        <ComboBoxItem Content="System" Tag="{x:Static models:AppTheme.System}" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Overlay" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Overlay&#10;- Shows recording and listening feedback.&#10;- Waveform stays visible even if the background is transparent.&#10;- SmartListen toggles can briefly show listening on/off.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Overlay Background Opacity" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Overlay Background Opacity&#10;- 0% hides only the background box.&#10;- 100% makes the box fully opaque.&#10;- Waveform and text remain visible.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Value, ElementName=OverlayOpacitySlider, StringFormat=Background {0:P0}}" />
                                                    <Slider AutomationProperties.Name="Overlay background opacity" x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" Value="{Binding Settings.OverlayOpacity, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="0% hides the box only; the waveform and text stay visible." Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Basic Cleanup" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Basic Cleanup&#10;- Runs locally before any optional AI re-write.&#10;- Cleans spacing and obvious transcript artifacts.&#10;- Spoken punctuation can turn words like comma into punctuation.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <CheckBox Content="Clean Up Transcripts" IsChecked="{Binding Settings.CleanupEnabled}" ToolTip="Turns local cleanup on or off before the text is inserted or sent for optional re-write." />
                                                    <CheckBox Content="Convert Spoken Punctuation" IsChecked="{Binding Settings.SpokenPunctuationEnabled}" ToolTip="Converts spoken punctuation words such as comma, period, new line, and question mark when cleanup is enabled." />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Text Insertion" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Text Insertion&#10;- Chooses how final text reaches the active app.&#10;- Optional clipboard retention helps when no text field was focused.&#10;- Paste mode is usually fastest.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Insertion Mode" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Insertion Mode&#10;- Paste with Clipboard Restore: fast paste, then tries to restore previous clipboard.&#10;- Type Characters: sends keystrokes one by one for apps that block paste.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Text insertion mode" SelectedValue="{Binding Settings.InsertionMode}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Paste with Clipboard Restore" Tag="{x:Static models:InsertionMode.Paste}" />
                                                        <ComboBoxItem Content="Type Characters" Tag="{x:Static models:InsertionMode.Type}" />
                                                    </ComboBox>
                                                    <CheckBox Content="Keep Inserted Text on Clipboard for Manual Paste" IsChecked="{Binding Settings.CopyInsertedTextToClipboard}" ToolTip="Keeps the latest inserted text on the clipboard so you can paste it manually if the wrong app or no text box was focused." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Privacy" Tag="Audio and local storage" Uid="&#xE72E;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Privacy settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <TextBlock Text="Audio is sent to Groq for transcription. Summaries, optional re-writing, and spoken action detection also send text to Groq. Temporary audio is deleted after processing by default." Style="{StaticResource BodyText}" />
                                            <CheckBox Content="Retain dictation audio for debugging" IsChecked="{Binding Settings.RetainAudioForDebugging}" />
                                            <TextBlock Text="Conversations and YouTube transcripts are saved automatically on this PC. Manage or delete each saved item from its own page. Dictation history is not stored." Style="{StaticResource BodyText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="System" Tag="Startup and updates" Uid="&#xE770;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="System settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Startup" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Startup&#10;- Start Minimized opens Wyspa to the tray.&#10;- Start with Windows runs it when your Windows user signs in.&#10;- Tray and app settings stay in sync.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <CheckBox Content="Start Minimized" IsChecked="{Binding Settings.StartMinimized}" ToolTip="When enabled, Wyspa opens quietly in the system tray instead of showing the main window." />
                                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" ToolTip="Adds or removes Wyspa from the current user's Windows startup registry entry." />
                                                    <TextBlock Text="Start with Windows uses the current Windows user startup registry entry." Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Updates" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Updates&#10;- Check for Updates compares this app version with GitHub releases.&#10;- Download Update opens the newer installer when available.&#10;- Running a newer installer updates the existing install.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource BodyText}" Margin="0,2,0,3" />
                                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Content="Check for Updates" />
                                                        <Button Command="{Binding OpenUpdateCommand}" IsEnabled="{Binding IsUpdateAvailable}" Content="Download Update" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Experimental" Tag="Wake voice, tone re-write, and spoken actions" Uid="&#xE9D9;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Experimental settings">
                                    <StackPanel Margin="4,8,4,4">
                                        <TextBlock Text="Wake voice, text re-writing, and spoken actions. Models use your Groq connection; refresh the list in Groq." Style="{StaticResource BodyText}" Margin="0,0,0,10" />
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Wake Voice" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Wake Voice&#10;- Optional local voice gate for SmartListen.&#10;- Requires a trained Hey Whisper style phrase.&#10;- Disabled settings below do nothing until this is turned on.">
                                                        <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                    </Border>
                                                </StackPanel>
                                                <CheckBox Content="Require Local Hey Whisper Match" IsChecked="{Binding Settings.AutoCaptureWakeVoiceEnabled}" ToolTip="When enabled, SmartListen waits for a local wake voice match before it records dictated text." />
                                                <StackPanel IsEnabled="{Binding IsWakeVoiceSettingsEnabled}">
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Wake Match Strictness" Style="{StaticResource FieldLabel}" />
                                                            <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Wake Match Strictness&#10;- 0% accepts looser matches.&#10;- 100% requires a closer voice match.&#10;- Train first, then adjust only if it misses or triggers too easily.">
                                                                <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Value, ElementName=WakeVoiceSensitivitySlider, StringFormat={}{0:P0}}" />
                                                    </Grid>
                                                    <Slider AutomationProperties.Name="Wake match strictness" x:Name="WakeVoiceSensitivitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" Value="{Binding Settings.AutoCaptureWakeVoiceSensitivity, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding WakeTrainingProgressText}" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Wake Voice Training&#10;- Record each displayed phrase in your normal voice.&#10;- Include the wake phrase and sample sentences.&#10;- Reset Training clears the local voice profile.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding WakeTrainingPromptText}" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                    </Border>
                                                    <WrapPanel Margin="0,2,0,3">
                                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecordWakeVoiceCommand}" Content="{Binding WakeVoiceButtonText}" />
                                                        <Button Command="{Binding ResetWakeVoiceCommand}" Content="Reset Training" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding WakeTrainingText}" Style="{StaticResource BodyText}" Margin="0,0,0,3" />
                                                    <TextBlock Text="{Binding WakeVoiceStatus}" Style="{StaticResource BodyText}" Margin="0,0,0,5" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Wake Accepted Tone" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Wake Accepted Tone&#10;- Plays when wake voice successfully starts listening.&#10;- Use Default restores Wyspa's built-in short tone.&#10;- Choose WAV lets you use your own local sound.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <CheckBox Content="Play a short tone when Wyspa starts listening" IsChecked="{Binding Settings.WakeToneEnabled}" ToolTip="Turns the wake accepted tone on or off. The recording still starts when off; it is just silent." />
                                                    <TextBlock Text="{Binding WakeToneText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                                                    <WrapPanel Margin="0,0,0,0">
                                                        <Button Click="ChooseWakeToneButton_OnClick" Content="Choose WAV" />
                                                        <Button Click="ResetWakeToneButton_OnClick" Content="Use Default" />
                                                        <Button Click="TestWakeToneButton_OnClick" Content="Test Tone" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Tone Re-write" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Tone Re-write&#10;- Optional Groq text pass after transcription.&#10;- Turns spoken wording into cleaner written text.&#10;- Uses the selected tone prompt and model.">
                                                        <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                    </Border>
                                                </StackPanel>
                                                <CheckBox Content="Re-write Dictated Text with Groq" IsChecked="{Binding Settings.GroqWritingCleanupEnabled}" ToolTip="When enabled, Wyspa sends the transcript to the selected Groq text model for polishing. Disabled means transcription is inserted directly after local cleanup." />
                                                <TextBlock Text="Tone Re-write Model" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TextModels}" SelectedItem="{Binding Models.RewriteModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Tone Re-write Model" />
                                                <TextBlock Text="Groq text model used to re-write dictated text." Style="{StaticResource BodyText}" FontSize="11" />
                                                <TextBlock Text="{Binding Models.RewriteSelection}" Style="{StaticResource BodyText}" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                                                <StackPanel IsEnabled="{Binding IsWritingCleanupSettingsEnabled}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Tone" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Tone&#10;- Formal: polished, professional wording.&#10;- Casual: natural everyday writing.&#10;- Technical: clearer structure for technical notes, support text, and instructions.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Writing cleanup tone" SelectedValue="{Binding Settings.WritingCleanupTone}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Formal" Tag="{x:Static models:WritingCleanupTone.Formal}" />
                                                        <ComboBoxItem Content="Casual" Tag="{x:Static models:WritingCleanupTone.Casual}" />
                                                        <ComboBoxItem Content="Technical" Tag="{x:Static models:WritingCleanupTone.Technical}" />
                                                    </ComboBox>
                                                    <Expander Margin="0,3,0,0">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Tone Re-write Prompts" />
                                                                <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Tone Re-write Prompts&#10;- Edit the instruction used for each tone.&#10;- Leave a prompt blank to use Wyspa's default.&#10;- Keep prompts focused on the writing style you want.">
                                                                    <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Formal Prompt" Style="{StaticResource FieldLabel}" />
                                                                <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Formal Prompt&#10;- Best for emails, messages, and professional wording.&#10;- Usually removes filler words and improves sentence flow.">
                                                                    <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Formal rewrite prompt" Text="{Binding Settings.FormalRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Casual Prompt" Style="{StaticResource FieldLabel}" />
                                                                <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Casual Prompt&#10;- Best for friendly messages.&#10;- Keeps the meaning natural without becoming too formal.">
                                                                    <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Casual rewrite prompt" Text="{Binding Settings.CasualRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Technical Prompt" Style="{StaticResource FieldLabel}" />
                                                                <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Technical Prompt&#10;- Best for procedures, bug notes, or technical explanations.&#10;- Encourages clearer structure and precise wording.">
                                                                    <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Technical rewrite prompt" Text="{Binding Settings.TechnicalRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Spoken Actions" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Spoken Actions&#10;- Lets Wyspa perform clear commands instead of inserting text.&#10;- Examples: copy, paste, Enter, Escape, Task View.&#10;- Turn this off for pure transcribe-and-insert behavior.">
                                                        <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                    </Border>
                                                </StackPanel>
                                                <CheckBox Content="Enable Spoken Commands and Groq Intent Actions" IsChecked="{Binding Settings.IntentActionsEnabled}" ToolTip="When enabled, Wyspa may execute supported actions from clear spoken commands. When disabled, it only inserts transcript text." />
                                                <TextBlock Text="Spoken Actions Model" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TextModels}" SelectedItem="{Binding Models.IntentModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Spoken Actions Model" />
                                                <TextBlock Text="Groq text model used to interpret spoken commands." Style="{StaticResource BodyText}" FontSize="11" />
                                                <TextBlock Text="{Binding Models.IntentSelection}" Style="{StaticResource BodyText}" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                                                <StackPanel IsEnabled="{Binding IsIntentSettingsEnabled}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Action Confidence Threshold" Style="{StaticResource FieldLabel}" />
                                                        <Border Style="{StaticResource HeaderHelpIcon}" ToolTip="Action Confidence Threshold&#10;- Higher means fewer accidental actions.&#10;- Lower means commands trigger more easily.&#10;- Increase it if normal speech is being treated as a command.">
                                                            <TextBlock Style="{StaticResource HeaderHelpText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Slider AutomationProperties.Name="Action confidence threshold" Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="False" Value="{Binding Settings.IntentConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Allowed actions: copy, paste, cut, select all, undo, redo, Enter, Tab, Escape, Backspace, Delete, Task View." Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
        </TabControl>
    </Grid>
</Window>
