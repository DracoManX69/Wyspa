                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="SaveHotkeyButton_OnClick" Margin="7,2,0,5" Content="Save Hotkey" ToolTip="Save and register the shortcut shown beside this button. Wyspa reports shortcuts already in use." />
                                                    </Grid>
                                                    <TextBlock Text="One shortcut follows the active mode: press to start/stop Toggle, hold for Hold to Talk, or press to turn SmartListen on/off. F13-F24 macro keys can be used without modifiers." Style="{StaticResource BodyText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="LookAndFeelSettingsGroup" Header="Look &amp; Feel" Tag="Theme, overlay, text cleanup, and insertion" Uid="&#xE790;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Look &amp; Feel settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                                                    <TextBlock Text="Choose an appearance. System follows your Windows theme. Accent colours always follow Windows." Style="{StaticResource BodyText}" Margin="0,4,0,4" />
                                                    <ComboBox x:Name="ThemeSelector" AutomationProperties.Name="Theme" SelectedValue="{Binding Settings.Theme, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" ToolTip="Choose Light, Dark or the Windows app theme. Accent colours follow Windows in every mode.">
                                                        <ComboBoxItem Content="Dark" Tag="{x:Static models:AppTheme.Dark}" />
                                                        <ComboBoxItem Content="Light" Tag="{x:Static models:AppTheme.Light}" />
                                                        <ComboBoxItem Content="System" Tag="{x:Static models:AppTheme.System}" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <CheckBox x:Name="WindowsNotificationsToggle" Content="Windows notifications" AutomationProperties.Name="Windows notifications" Style="{StaticResource SettingsToggle}" IsChecked="{Binding Settings.WindowsNotificationsEnabled, UpdateSourceTrigger=PropertyChanged}" ToolTip="Turn off to silence all Windows notifications from Wyspa. Recording and in-app feedback remain visible." />
                                                    <TextBlock Text="Allow Wyspa to send Windows notifications. Turn off to silence all Wyspa Windows notifications; the recording overlay stays available." Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Overlay" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Overlay&#10;- Animated red means speech is detected.&#10;- Animated green means quiet listening or processing.&#10;- The waveform disappears when processing finishes and remains visible over a transparent background." />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Overlay Background Opacity" Style="{StaticResource FieldLabel}" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Overlay Background Opacity&#10;- 0% hides only the background box.&#10;- 100% makes the box fully opaque.&#10;- Waveform and text remain visible." />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Value, ElementName=OverlayOpacitySlider, StringFormat=Background {0:P0}}" />
                                                    <Slider ToolTipService.InitialShowDelay="400" ToolTipService.BetweenShowDelay="100" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Overlay background opacity" x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" Value="{Binding Settings.OverlayOpacity, UpdateSourceTrigger=PropertyChanged}" ToolTip="Adjust the recorder panel background from transparent to opaque. The waveform and status text remain visible." />
                                                    <TextBlock Text="0% hides the box only; the waveform and text stay visible." Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Basic Cleanup" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Basic Cleanup&#10;- Applies to non-streaming dictation before optional Tone Re-write.&#10;- Cleans spacing and obvious transcript artifacts.&#10;- Spoken punctuation can turn words like comma into punctuation." />
                                                    </StackPanel>
                                                    <CheckBox Content="Clean Up Transcripts" IsChecked="{Binding Settings.CleanupEnabled}" ToolTip="Apply local spacing and punctuation cleanup to non-streaming dictation. Stream Mode uses its own recognition pipeline and optional Stream Fix." />
                                                    <CheckBox Content="Convert Spoken Punctuation" IsChecked="{Binding Settings.SpokenPunctuationEnabled}" ToolTip="Convert spoken punctuation such as comma, period and new line when local cleanup is enabled. Applies to non-streaming dictation." />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Text Insertion" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Text Insertion&#10;- Chooses how final text reaches the active app.&#10;- Non-streaming clipboard retention keeps the result after insertion; Stream Mode always keeps a backup.&#10;- Paste mode is usually fastest." />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Insertion Mode" Style="{StaticResource FieldLabel}" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Insertion Mode&#10;- Paste with Clipboard Restore: fast paste, then tries to restore previous clipboard.&#10;- Type Characters: sends keystrokes one by one for apps that block paste." />
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Text insertion mode" SelectedValue="{Binding Settings.InsertionMode}" SelectedValuePath="Tag" ToolTip="Paste uses the clipboard and restores its previous content unless retention is on. Type sends characters. Live streaming uses typing; this choice also applies to verified Stream Fix replacement.">
                                                        <ComboBoxItem Content="Paste with Clipboard Restore" Tag="{x:Static models:InsertionMode.Paste}" />
                                                        <ComboBoxItem Content="Type Characters" Tag="{x:Static models:InsertionMode.Type}" />
                                                    </ComboBox>
                                                    <CheckBox Content="Keep Inserted Text on Clipboard for Manual Paste" IsChecked="{Binding Settings.CopyInsertedTextToClipboard}" ToolTip="Keep the completed non-streaming dictation on the clipboard after insertion. Stream Mode always keeps a cumulative clipboard backup." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Privacy" Tag="Audio and local storage" Uid="&#xE72E;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Privacy settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <TextBlock Text="Audio is sent to Groq for transcription. Summaries, optional re-writing, and spoken action detection also send text to Groq. Temporary audio is deleted after processing by default." Style="{StaticResource BodyText}" />
                                            <CheckBox Content="Retain dictation audio for debugging" IsChecked="{Binding Settings.RetainAudioForDebugging}" ToolTip="Keep dictation audio files on this computer for troubleshooting instead of deleting them after processing. Audio may contain sensitive speech." />
                                            <TextBlock Text="Conversations and YouTube transcripts are saved automatically on this PC. Manage or delete each saved item from its own page. Dictation history is not stored." Style="{StaticResource BodyText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="System" Tag="Startup and updates" Uid="&#xE770;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="System settings">
                                    <StackPanel Margin="4,8,4,4">

                                        <StackPanel>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Startup" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Startup&#10;- Start Minimized opens Wyspa to the tray.&#10;- Start with Windows runs it when your Windows user signs in.&#10;- Tray and app settings stay in sync." />
                                                    </StackPanel>
                                                    <CheckBox Content="Start Minimized" IsChecked="{Binding Settings.StartMinimized}" ToolTip="When enabled, Wyspa opens quietly in the system tray instead of showing the main window." />
                                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" ToolTip="Start Wyspa automatically when you sign in to Windows." />
                                                    <TextBlock Text="Start with Windows uses the current Windows user startup registry entry." Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Updates" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Updates&#10;- Check for Updates compares this app version with GitHub releases.&#10;- Download Update opens the newer installer when available.&#10;- Running a newer installer updates the existing install." />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource BodyText}" Margin="0,2,0,3" />
                                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Content="Check for Updates" ToolTip="Check GitHub for a newer release. This does not install anything automatically." />
                                                        <Button Command="{Binding OpenUpdateCommand}" IsEnabled="{Binding IsUpdateAvailable}" Content="Download Update" ToolTip="Open the newer release when one is available. Run its installer to update Wyspa." />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Experimental" Tag="Stream fix, wake voice, tone re-write, and spoken actions" Uid="&#xE9D9;" Style="{StaticResource SettingsGroup}" IsExpanded="False" AutomationProperties.Name="Experimental settings">
                                    <StackPanel Margin="4,8,4,4">
                                        <TextBlock Text="Optional features to try. Wake phrase detection runs locally; text rewriting and AI actions use your Groq connection." Style="{StaticResource BodyText}" Margin="0,0,0,10" />
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Stream Fix" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                <CheckBox Content="Stream Fix" AutomationProperties.Name="Stream Fix" IsEnabled="{Binding Settings.StreamModeEnabled}" IsChecked="{Binding Settings.StreamFixEnabled, UpdateSourceTrigger=PropertyChanged}" ToolTip="Proofread only this dictation when recording ends. Requires Stream Mode. Verified dictated text can be replaced automatically; the final clipboard always holds the result." />
                                                <TextBlock Text="Requires Stream Mode in Capture &amp; Shortcuts. After dictation, checks punctuation, hesitations and simple grammar while keeping your wording. Changes apply to the next recording." Style="{StaticResource BodyText}" />
                                                <TextBlock Text="Replaces only the passage Wyspa typed during this dictation. Existing text is never sent for cleanup. Leave the cursor and text untouched; if the editor cannot verify the passage, the finished version stays on the clipboard." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                                <TextBlock Text="Uses the Tone Re-write model selected below, with its own conservative proofreading rules. Adds a Groq text request; Tone Re-write does not need to be enabled." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Wake Voice" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Wake Voice&#10;- Local English keyword detector for SmartListen.&#10;- Use the personal wake wizard to learn your pronunciation and adjust matching automatically.&#10;- Say the phrase, wait for the ready tone, then dictate." />
                                                </StackPanel>
                                                <TextBlock Text="An English keyword detector checks the actual phrase locally. It prepares about 39 MB of local wake, speech-detection and verification models once; existing matching downloads are reused. In SmartListen, say the phrase, wait for the ready tone, then dictate; your silence setting stops recording and the detector waits for the next phrase. The wake phrase is excluded from dictation pre-roll." Style="{StaticResource BodyText}" Margin="0,6,0,8" />
                                                <TextBlock Text="Wake phrases are available only in SmartListen mode." Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                                                <StackPanel>
                                                    <StackPanel DataContext="{Binding WakeCalibration}" IsEnabled="{Binding IsSmartListen}">
                                                        <CheckBox Content="Enable wake phrases" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Enable wake phrases" ToolTip="In SmartListen, wait for this phrase before dictation starts. Enabling also starts hands-free monitoring; practice is optional." />
                                                        <TextBlock Text="Wake phrase" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="60" AutomationProperties.Name="Wake phrase" ToolTip="Use two to five English words. Practice or enabling automatically saves the phrase." />
                                                        <TextBlock Text="Personal wake setup" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                                        <TextBlock Text="A short wizard learns how you naturally say your phrase and optimizes matching strictness. Speak in your own voice; Wyspa adapts to you." Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                                                        <Button Content="{Binding WizardLabel}" Click="OpenWakeSetup_OnClick" IsEnabled="{Binding CanEdit}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.Name="Open wake setup wizard" ToolTip="Open the personal wake wizard. Recording begins only when you choose Record sample." />
                                                        <TextBlock Text="{Binding WizardOpenError}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
                                                        <TextBlock Text="{Binding TuningSummary}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="4">
                                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelAltBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAwake}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            <TextBlock Text="{Binding Runtime}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Wake Accepted Tone" Style="{StaticResource FieldLabel}" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Wake Accepted Tone&#10;- Plays when wake voice successfully starts listening.&#10;- Use Default restores Wyspa's built-in short tone.&#10;- Choose WAV lets you use your own local sound." />
                                                    </StackPanel>
                                                    <CheckBox Content="Play a short tone when Wyspa starts listening" IsChecked="{Binding Settings.WakeToneEnabled}" ToolTip="Turns the wake accepted tone on or off. The recording still starts when off; it is just silent." />
                                                    <TextBlock Text="{Binding WakeToneText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                                                    <WrapPanel Margin="0,0,0,0">
                                                        <Button Click="ChooseWakeToneButton_OnClick" Content="Choose WAV" ToolTip="Choose a local WAV file to play when wake voice starts listening." />
                                                        <Button Click="ResetWakeToneButton_OnClick" Content="Use Default" ToolTip="Restore the built-in wake-accepted sound." />
                                                        <Button Click="TestWakeToneButton_OnClick" Content="Test Tone" ToolTip="Play the currently selected wake-accepted sound." />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Tone Re-write" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Tone Re-write&#10;- Optional Groq text pass for non-streaming dictation.&#10;- Turns spoken wording into cleaner written text.&#10;- Uses the selected tone prompt and model." />
                                                </StackPanel>
                                                <CheckBox Content="Re-write Dictated Text with Groq" IsChecked="{Binding Settings.GroqWritingCleanupEnabled}" ToolTip="Polish non-streaming dictation with the selected Groq text model and tone prompt. Stream Mode bypasses Tone Re-write; use Stream Fix for conservative stream cleanup." />
                                                <TextBlock Text="Tone Re-write Model" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TextModels}" SelectedItem="{Binding Models.RewriteModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Tone Re-write Model" ToolTip="Choose the text model used by Tone Re-write and Stream Fix. Each uses its own instructions." />
                                                <TextBlock Text="Groq text model used to re-write dictated text." Style="{StaticResource BodyText}" FontSize="11" />
                                                <TextBlock Text="{Binding Models.RewriteSelection}" Style="{StaticResource BodyText}" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                                                <StackPanel IsEnabled="{Binding IsWritingCleanupSettingsEnabled}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Tone" Style="{StaticResource FieldLabel}" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Tone&#10;- Formal: polished, professional wording.&#10;- Casual: natural everyday writing.&#10;- Technical: clearer structure for technical notes, support text, and instructions." />
                                                    </StackPanel>
                                                    <ComboBox AutomationProperties.Name="Writing cleanup tone" SelectedValue="{Binding Settings.WritingCleanupTone}" SelectedValuePath="Tag" ToolTip="Choose Formal, Casual or Technical wording for non-streaming Tone Re-write. Stream Fix does not use these tone prompts.">
                                                        <ComboBoxItem Content="Formal" Tag="{x:Static models:WritingCleanupTone.Formal}" />
                                                        <ComboBoxItem Content="Casual" Tag="{x:Static models:WritingCleanupTone.Casual}" />
                                                        <ComboBoxItem Content="Technical" Tag="{x:Static models:WritingCleanupTone.Technical}" />
                                                    </ComboBox>
                                                    <Expander Margin="0,3,0,0">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Tone Re-write Prompts" />
                                                                <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Tone Re-write Prompts&#10;- Edit the instruction used for each tone.&#10;- Leave a prompt blank to use Wyspa's default.&#10;- Keep prompts focused on the writing style you want." />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Formal Prompt" Style="{StaticResource FieldLabel}" />
                                                                <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Formal Prompt&#10;- Best for emails, messages, and professional wording.&#10;- Usually removes filler words and improves sentence flow." />
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Formal rewrite prompt" Text="{Binding Settings.FormalRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" ToolTip="Customize instructions for Formal Tone Re-write. Leave blank to use the built-in prompt. Saved when you leave the field." />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Casual Prompt" Style="{StaticResource FieldLabel}" />
                                                                <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Casual Prompt&#10;- Best for friendly messages.&#10;- Keeps the meaning natural without becoming too formal." />
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Casual rewrite prompt" Text="{Binding Settings.CasualRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" ToolTip="Customize instructions for Casual Tone Re-write. Leave blank to use the built-in prompt. Saved when you leave the field." />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Technical Prompt" Style="{StaticResource FieldLabel}" />
                                                                <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Technical Prompt&#10;- Best for procedures, bug notes, or technical explanations.&#10;- Encourages clearer structure and precise wording." />
                                                            </StackPanel>
                                                            <TextBox AutomationProperties.Name="Technical rewrite prompt" Text="{Binding Settings.TechnicalRewritePrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" ToolTip="Customize instructions for Technical Tone Re-write. Leave blank to use the built-in prompt. Saved when you leave the field." />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Spoken Actions" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                                    <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Spoken Actions&#10;- Non-streaming dictation can perform clear commands instead of inserting text.&#10;- Examples: copy, paste, Enter, Escape, Task View.&#10;- Turn this off for pure transcribe-and-insert behavior." />
                                                </StackPanel>
                                                <CheckBox Content="Enable Spoken Commands and Groq Intent Actions" IsChecked="{Binding Settings.IntentActionsEnabled}" ToolTip="Allow supported spoken commands to run actions in non-streaming dictation. Turn off for text-only dictation. Stream Mode always bypasses spoken actions." />
                                                <TextBlock Text="Spoken Actions Model" Style="{StaticResource FieldLabel}" />
                                                <ComboBox Tag="GroqModel" ItemsSource="{Binding Models.TextModels}" SelectedItem="{Binding Models.IntentModel, Mode=TwoWay}" IsEnabled="{Binding Models.CanRefresh}" AutomationProperties.Name="Spoken Actions Model" ToolTip="Choose the Groq text model used to interpret supported spoken commands in non-streaming dictation." />
                                                <TextBlock Text="Groq text model used to interpret spoken commands." Style="{StaticResource BodyText}" FontSize="11" />
                                                <TextBlock Text="{Binding Models.IntentSelection}" Style="{StaticResource BodyText}" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                                                <StackPanel IsEnabled="{Binding IsIntentSettingsEnabled}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Action Confidence Threshold" Style="{StaticResource FieldLabel}" />
                                                        <local:HelpButton Style="{StaticResource HeaderHelpIcon}" HelpText="Action Confidence Threshold&#10;- Higher means fewer accidental actions.&#10;- Lower means commands trigger more easily.&#10;- Increase it if normal speech is being treated as a command." />
                                                    </StackPanel>
                                                    <Slider ToolTipService.InitialShowDelay="400" ToolTipService.BetweenShowDelay="100" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Action confidence threshold" Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="False" Value="{Binding Settings.IntentConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="Raise this to require more confidence before a spoken action runs. Lower values make commands easier to trigger." />
                                                    <TextBlock Text="Allowed actions: copy, paste, cut, select all, undo, redo, Enter, Tab, Escape, Backspace, Delete, Task View." Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
        </TabControl>
    </Grid>
</Window>
